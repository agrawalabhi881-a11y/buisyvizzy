# Copy to .env, then replace both placeholders with generated URL-safe values.
POSTGRES_DB=supply_chain
POSTGRES_USER=supply_chain
POSTGRES_PASSWORD=replace-with-generated-url-safe-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=postgresql+psycopg://supply_chain:replace-with-generated-url-safe-password@localhost:5432/supply_chain
JWT_SECRET_KEY=replace-with-generated-random-secret-at-least-32-characters
